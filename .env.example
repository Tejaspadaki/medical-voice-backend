# Project Configuration
PROJECT_NAME="Medical Speech Transcription API"
ENVIRONMENT="development"
DEBUG=True

# Database (SQLite default for SQL relational storage)
DATABASE_URL="sqlite:///./medical_system.db"

# Redis Cache / Queue
REDIS_URL="redis://localhost:6379/0"

# JWT Security
JWT_SECRET_KEY="supersecretmedicalkeychangeinproductionsecure2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Voice AI & Clinical Orchestrator (Gemini 2.5 Flash)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
SARVAM_API_KEY=""
VOICE_ACTION_TTL_SECONDS=300
DEFAULT_CLINICAL_LANGUAGE="kn"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
